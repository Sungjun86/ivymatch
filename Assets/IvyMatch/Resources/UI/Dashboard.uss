/* ==========================================================================
   IvyMatch Dashboard.uss  (UI Toolkit runtime, Unity 2022.3+ / 6000.0)
   Contract: CONTRACT.md section 7.
   USS notes: no box-shadow, no gap, no grid, no CSS media queries.
   Responsive behaviour = controller toggles the `narrow` class on `.root`.
   ========================================================================== */

:root {
    --bg: #0c0e12;
    --surface: #141720;
    --surface2: #1c2030;
    --border: rgba(255, 255, 255, 0.07);
    --border2: rgba(255, 255, 255, 0.13);
    --text: #e8eaf0;
    --muted: #7a8099;
    --accent: #5b8dff;
    --accent-soft: rgba(91, 141, 255, 0.12);
    --accent-line: rgba(91, 141, 255, 0.25);
}

/* --------------------------------------------------------------------------
   Base. Font is applied to .root by IvyMatchBootstrap (inherited by children).
   Resources/Fonts/NotoSansKR-Regular first, then an OS Korean font.
   
   -------------------------------------------------------------------------- */
.root {
    /* font is assigned in code (IvyMatchBootstrap) so a missing font file cannot blank the UI */
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    color: var(--text);
}

/* Reset Unity's default label chrome (same specificity as theme, ours loads later). */
.unity-label {
    margin: 0;
    padding: 0;
    color: var(--text);
    white-space: normal;
}

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */
.header {
    flex-shrink: 0;
    padding: 28px 20px 16px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}
.header-title {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
    color: var(--text);
}
.header-sub {
    margin-top: 6px;
    font-size: 13px;
    color: var(--muted);
}

/* --------------------------------------------------------------------------
   Filter pills
   -------------------------------------------------------------------------- */
.filter-bar {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16px 20px 4px 20px;
}
.filter-btn {
    margin: 0 8px 8px 0;
    padding: 6px 14px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 20px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}
.filter-btn:hover {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.04);
    border-color: var(--border2);
}
.filter-btn:active,
.filter-btn:focus {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--border2);
}
.filter-btn.active,
.filter-btn.active:hover,
.filter-btn.active:active,
.filter-btn.active:focus {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent-line);
}

/* --------------------------------------------------------------------------
   Summary / empty state
   -------------------------------------------------------------------------- */
.summary-bar {
    flex-shrink: 0;
    padding: 8px 20px 12px 20px;
    font-size: 12px;
    color: var(--muted);
}
.empty-state {
    flex-shrink: 0;
    margin: 24px 20px;
    padding: 24px 16px;
    font-size: 14px;
    color: var(--muted);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 16px;
}

/* --------------------------------------------------------------------------
   Search row + filter panel (built in code by FilterPanelView, CONTRACT section 11)
   -------------------------------------------------------------------------- */
.search-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 16px 20px 0 20px;
}
.search-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    height: 38px;
}
.search-field {
    flex-grow: 1;
    margin: 0;
    height: 38px;
}
.search-field .unity-base-text-field__input,
.search-field .unity-text-field__input {
    padding: 0 12px;
    font-size: 14px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 10px;
    -unity-text-align: middle-left;
}
.search-field:focus .unity-base-text-field__input,
.search-field:focus .unity-text-field__input {
    border-color: var(--accent-line);
}
.search-placeholder {
    position: absolute;
    left: 13px;
    right: 8px;
    top: 0;
    bottom: 0;
    font-size: 14px;
    color: var(--muted);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}
.search-clear,
.filter-toggle {
    flex-shrink: 0;
    height: 38px;
    margin: 0 0 0 8px;
    padding: 0 12px;
    font-size: 13px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 10px;
}
.search-clear {
    width: 38px;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
}
.filter-toggle.active {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent-line);
}
.active-filters {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 20px 4px 20px;
}
.filter-panel {
    flex-shrink: 0;
    margin: 4px 20px 12px 20px;
    padding: 12px 16px 14px 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 14px;
}
.filter-cat-title {
    margin: 10px 0 6px 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--muted);
}
.chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}
.chip {
    margin: 0 6px 6px 0;
    padding: 5px 11px;
    font-size: 12px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 16px;
}
.chip:hover {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.04);
}
.chip.active,
.chip.active:hover {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent-line);
}
.chip.chip-reset {
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--border);
}
.filter-reset {
    align-self: flex-start;
    margin: 12px 0 0 0;
    padding: 6px 14px;
    font-size: 12px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 16px;
}

/* --------------------------------------------------------------------------
   List / map switch + US map (UsMapView, CONTRACT section 12)
   -------------------------------------------------------------------------- */
.view-btn.view-first {
    margin-left: 12px;
}
.map-view {
    flex-shrink: 0;
    margin: 0 20px 16px 20px;
}
.map-regions {
    margin-bottom: 6px;
}
.map-surface {
    position: relative;
    width: 100%;
    height: 300px;              /* replaced in code: width / map aspect */
    overflow: hidden;
    background-color: var(--bg);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 14px;
}
.map-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.map-anchor {
    position: absolute;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.map-marker {
    margin: 0;
    padding: 0 5px;
    height: 20px;
    min-width: 22px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-width: 1px;
    border-color: rgba(12, 14, 18, 0.9);
    border-radius: 5px;
}
.map-marker.selected {
    border-width: 2px;
    border-color: #ffffff;
    scale: 1.2 1.2;
}
.map-cluster {
    margin: 0;
    padding: 0;
    width: 24px;
    height: 24px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #ffffff;
    background-color: var(--accent);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 12px;
}
.map-cluster.selected {
    border-color: #ffd100;
}
.map-dot {
    width: 6px;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 3px;
}
.map-caption {
    margin-top: 6px;
    font-size: 11px;
    color: var(--muted);
}

/* --------------------------------------------------------------------------
   Card grid (ScrollView > card-grid)
   -------------------------------------------------------------------------- */
.card-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Slim overlay scrollbar (replaces the default arrows + thick grey bar).
   "#card-scroll" (name selector) outranks the default theme's class selectors.
   On narrow screens the controller hides the vertical scroller entirely (touch scrolling only). */
#card-scroll .unity-scroller--vertical {
    position: absolute;
    top: 6px;
    bottom: 6px;
    right: 2px;
    width: 8px;
    min-width: 8px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
#card-scroll .unity-scroller--vertical .unity-scroller__low-button,
#card-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}
#card-scroll .unity-scroller--vertical .unity-scroller__slider {
    flex-grow: 1;
    width: 8px;
    min-width: 8px;
    margin: 0;
}
#card-scroll .unity-scroller--vertical .unity-base-slider__input {
    width: 8px;
    min-width: 8px;
}
#card-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 8px;
    left: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
#card-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    left: 2px;
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.16);
    transition-property: background-color, width, left;
    transition-duration: 0.15s;
}
#card-scroll .unity-scroller--vertical:hover .unity-base-slider__dragger,
#card-scroll .unity-scroller--vertical .unity-base-slider__dragger:active {
    width: 6px;
    left: 1px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.32);
}
#card-scroll .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}
.card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding: 0 12px 24px 12px;
}

/* Card */
.card {
    width: 260px;
    flex-grow: 1;
    flex-shrink: 0;
    margin: 8px;
    padding: 20px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 16px;
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}
.card:hover {
    border-color: var(--border2);
}
.card.selected {
    border-color: var(--accent);
    background-color: var(--surface2);
}

/* If the controller adds the card via Instantiate(), each card is wrapped in a
   TemplateContainer. These rules make that wrapper the flex item so the grid
   still wraps and stretches correctly. (Harmless when CloneTree(target) is used.) */
.card-grid > TemplateContainer {
    width: 276px;
    flex-grow: 1;
    flex-shrink: 0;
}
TemplateContainer > .card {
    width: auto;
    flex-grow: 1;
}

/* Narrow (portrait phone): one card per row, full width. */
.narrow .card-grid {
    padding: 0 20px 24px 20px;
}
.narrow .card {
    width: 100%;
    flex-grow: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    margin-bottom: 6px;
}
.narrow .card-grid > TemplateContainer {
    width: 100%;
    flex-grow: 0;
}

/* Card header */
.card-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}
.logo {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #ffffff;
    background-color: var(--accent);
    border-radius: 10px;
}
.card-titles {
    flex-grow: 1;
    flex-shrink: 1;
}
.school-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
}
.school-cycle {
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
}

/* Big rate number */
.rate-label {
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
}
.rate-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
}
.rate-value {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--text);
}
.rate-unit {
    margin-left: 3px;
    margin-bottom: 7px;
    font-size: 16px;
    color: var(--muted);
}

/* Bars (scale 0-20% is applied by code through bar-fill width) */
.bars {
    margin-bottom: 14px;
}
.bar-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 6px;
}
.bar-label {
    width: 88px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--muted);
}
.bar-track {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    height: 6px;
    margin: 0 8px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}
.bar-fill {
    width: 0;
    height: 100%;
    border-radius: 3px;
}
.bar-fill.overall {
    background-color: #85B7EB;
}
.bar-fill.early {
    background-color: #185FA5;
}
.bar-fill.regular {
    background-color: #B5D4F4;
}
.bar-value {
    width: 44px;
    flex-shrink: 0;
    font-size: 12px;
    -unity-text-align: middle-right;
    color: var(--text);
}
/* Optional: controller may add this to a bar-row whose value is null. */
.bar-row.dim {
    opacity: 0.5;
}

/* Footer */
.card-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border);
}
.footer-text {
    margin-right: 10px;
    font-size: 11px;
    color: var(--muted);
}
.footer-source {
    flex-grow: 1;
    flex-shrink: 1;
}

/* --------------------------------------------------------------------------
   Tags / chips
   -------------------------------------------------------------------------- */
.tag {
    margin: 0 6px 6px 0;
    padding: 3px 12px;
    font-size: 12px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 12px;
}
.tag.blue {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent-line);
}
.early-badge {
    margin: 0;
    padding: 2px 8px;
    font-size: 10px;
    -unity-text-align: middle-center;
    border-radius: 8px;
}

/* --------------------------------------------------------------------------
   Detail panel
   -------------------------------------------------------------------------- */
.detail-panel {
    flex-shrink: 0;
    margin: 0 20px 16px 20px;
    padding: 20px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 20px;
}
.detail-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}
.detail-titles {
    flex-grow: 1;
    flex-shrink: 1;
}
.detail-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text);
}
.detail-sub {
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
}
.close-btn {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 16px;
}
.close-btn:hover,
.close-btn:active,
.close-btn:focus {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--border2);
}

.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}
.stat-box {
    flex-grow: 1;
    min-width: 96px;
    margin: 0 8px 8px 0;
    padding: 10px 12px;
    background-color: var(--surface2);
    border-radius: 12px;
}
.stat-box-label {
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--muted);
}
.stat-box-val {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
}

/* v2 info block (detail panel) */
.info-grid {
    flex-direction: column;
    margin-bottom: 12px;
    padding: 10px 12px;
    background-color: var(--surface2);
    border-radius: 12px;
}
.info-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 0;
}
.info-key {
    width: 118px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--muted);
}
.info-val {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: var(--text);
    white-space: normal;
}

/* Card with no verified rate yet: the big number is a dash, keep it quiet */
.card.no-rate .rate-value {
    color: var(--muted);
}

.tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}
.notable-text {
    margin-bottom: 16px;
    font-size: 14px;
    color: var(--muted);
}

.action-btns {
    flex-direction: row;
    flex-wrap: wrap;
}
.action-btn {
    margin: 0 8px 8px 0;
    padding: 8px 16px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 10px;
}
.action-btn:hover,
.action-btn:active,
.action-btn:focus {
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--border2);
}
.action-btn.active,
.action-btn.active:hover {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent-line);
}

/* Section bodies. Controller fills these with Labels (.section-item) / chips. */
.section {
    margin-top: 8px;
    padding: 12px 14px;
    background-color: var(--surface2);
    border-radius: 12px;
}
.section-item {
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--muted);
}
.compare-chip {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
    padding: 8px 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
}
.compare-chip.current {
    border-color: var(--accent-line);
}
.compare-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text);
}
.compare-rate {
    font-size: 12px;
    color: var(--muted);
}

.section-title {
    margin-top: 16px;
    margin-bottom: 6px;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--accent);
}
.sources {
    flex-direction: column;
}
.source-link {
    margin-bottom: 4px;
    font-size: 12px;
    color: var(--accent);
}

/* --------------------------------------------------------------------------
   Utility (keep LAST so it wins over same-specificity display rules above)
   -------------------------------------------------------------------------- */
.hidden {
    display: none;
}
