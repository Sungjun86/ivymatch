<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Dashboard.uss" />
    <ui:VisualElement name="root" class="root">

        <!-- Header -->
        <ui:VisualElement class="header">
            <ui:Label name="header-title" class="header-title" text="Ivy League Admissions" />
            <ui:Label name="header-sub" class="header-sub" text="8 universities" />
        </ui:VisualElement>

        <!-- Search row: FilterPanelView fills it (text field, clear, Filters toggle). CONTRACT section 11. -->
        <ui:VisualElement name="search-bar" class="search-bar" />

        <!-- Filter pills -->
        <ui:VisualElement name="filter-bar" class="filter-bar">
            <ui:Button name="filter-all" class="filter-btn active" text="All" />
            <ui:Button name="filter-low" class="filter-btn" text="&lt;5%" />
            <ui:Button name="filter-mid" class="filter-btn" text="5–10%" />
            <ui:Button name="filter-high" class="filter-btn" text="&gt;10%" />
            <!-- List / map switch (CONTRACT section 12) -->
            <ui:Button name="view-list" class="filter-btn view-btn view-first active" text="List · 목록" />
            <ui:Button name="view-map" class="filter-btn view-btn" text="Map · 지도" />
        </ui:VisualElement>

        <!-- Removable chips for the active search filters (filled by FilterPanelView, hidden when empty). -->
        <ui:VisualElement name="active-filters" class="active-filters hidden" />

        <!-- Scrolling page: summary, detail panel and cards all scroll together, so an open
             detail panel can never squeeze the card list to zero height on a phone. -->
        <ui:ScrollView name="card-scroll" class="card-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <!-- Filter categories (filled by FilterPanelView). Inside the scroll view so it never hides the list. -->
            <ui:VisualElement name="filter-panel" class="filter-panel hidden" />
            <ui:Label name="summary-bar" class="summary-bar" text="Showing 8" />
            <ui:Label name="empty-state" class="empty-state hidden" text="No schools match this filter · 조건에 맞는 학교가 없습니다" />

            <!-- US map (map mode only; UsMapView fills it). Above the detail panel so a tapped school opens right below. -->
            <ui:VisualElement name="map-view" class="map-view hidden" />

            <!-- Detail panel (shown when a card is selected) -->
            <ui:VisualElement name="detail-panel" class="detail-panel hidden">
                <ui:VisualElement class="detail-top">
                    <ui:VisualElement class="detail-titles">
                        <ui:Label name="detail-title" class="detail-title" text="School" />
                        <ui:Label name="detail-sub" class="detail-sub" text="" />
                    </ui:VisualElement>
                    <ui:Button name="detail-close" class="close-btn" text="×" />
                </ui:VisualElement>

                <ui:VisualElement class="stat-row">
                    <ui:VisualElement class="stat-box">
                        <ui:Label class="stat-box-label" text="Applied · 지원" />
                        <ui:Label name="stat-applied" class="stat-box-val" text="—" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-box">
                        <ui:Label class="stat-box-label" text="Admitted · 합격" />
                        <ui:Label name="stat-admitted" class="stat-box-val" text="—" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-box">
                        <ui:Label class="stat-box-label" text="Enrolled · 등록" />
                        <ui:Label name="stat-enrolled" class="stat-box-val" text="—" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-box">
                        <ui:Label class="stat-box-label" text="SAT mid-50" />
                        <ui:Label name="stat-sat" class="stat-box-val" text="—" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-box">
                        <ui:Label class="stat-box-label" text="ACT mid-50" />
                        <ui:Label name="stat-act" class="stat-box-val" text="—" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- v2 info block: deadlines / tests / cost / aid / international / essays -->
            <ui:VisualElement name="info-grid" class="info-grid">
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Deadlines · 마감" />
                    <ui:Label name="info-deadlines" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Tests · 시험" />
                    <ui:Label name="info-test" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Cost / yr · 연간 비용" />
                    <ui:Label name="info-cost" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Intl aid · 국제학생 지원" />
                    <ui:Label name="info-aid" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="International · 국제학생" />
                    <ui:Label name="info-intl" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Supplements · 보충 에세이" />
                    <ui:Label name="info-essays" class="info-val" text="—" />
                </ui:VisualElement>
                <ui:VisualElement class="info-row">
                    <ui:Label class="info-key" text="Majors · 전공 (졸업생 비중)" />
                    <ui:Label name="info-majors" class="info-val" text="—" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="detail-tags" class="tags" />
                <ui:Label name="detail-notable" class="notable-text" text="" />

                <ui:VisualElement class="action-btns">
                    <ui:Button name="btn-strategy" class="action-btn" text="Strategy · 전략" />
                    <ui:Button name="btn-lookfor" class="action-btn" text="What they look for · 평가 포인트" />
                    <ui:Button name="btn-compare" class="action-btn" text="Compare · 비교" />
                </ui:VisualElement>

                <!-- Section containers: kept empty on purpose, the controller fills them. -->
                <ui:VisualElement name="section-strategy" class="section hidden" />
                <ui:VisualElement name="section-lookfor" class="section hidden" />
                <ui:VisualElement name="section-compare" class="section hidden" />

                <ui:Label class="section-title" text="Sources · 출처" />
                <ui:VisualElement name="detail-sources" class="sources" />
            </ui:VisualElement>

            <ui:VisualElement name="card-grid" class="card-grid" />
        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
